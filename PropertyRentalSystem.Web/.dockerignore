# Build artifacts — regenerated by dotnet restore/publish inside the image;
# copying host-built ones in wastes the build context and can leak a
# different SDK's output into the container's dotnet restore/publish.
bin/
obj/
**/bin/
**/obj/

# IDE / OS cruft, never needed to build or run the app
.vs/
.idea/
*.user
.DS_Store

# Dev-only config — the container always runs with ASPNETCORE_ENVIRONMENT=Production
# (set in docker-compose.yml), so the Development overrides are never read.
appsettings.Development.json

# Not part of the image build itself
Dockerfile
.dockerignore
