@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold text-primary">Property Rental System</h1>
    <p class="lead text-muted mt-3">
        A modern platform for managing real estate, rentals, tenants, and rental requests.
    </p>
    <hr class="w-25 mx-auto my-4">
</div>

<div class="row text-start mt-4">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h3 class="h5 text-dark fw-bold">🏠 Property Catalog</h3>
                <p class="text-muted small mt-2">
                    Convenient browsing of real estate and available units with filtering by price, number of rooms, and availability status.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h3 class="h5 text-dark fw-bold">📝 Rental Applications</h3>
                <p class="text-muted small mt-2">
                    Multi-step wizard for tenant applications and a complete workflow processing system for managers.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h3 class="h5 text-dark fw-bold">📋 Agreements & History</h3>
                <p class="text-muted small mt-2">
                    Automatic generation of 12-month lease agreements upon request approval and tracking of tenant residency history.
                </p>
            </div>
        </div>
    </div>
</div>