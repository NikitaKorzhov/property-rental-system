@model PropertyRentalSystem.Web.ViewModels.Units.UnitFormViewModel
@{
    var isEdit = Model.Id != 0;
    var action = isEdit ? Url.Action("Edit", "Units", new { id = Model.Id }) : Url.Action("Create", "Units");
}
<form action="@action" method="post"
      data-refresh-url="@Url.Action("List", "Properties")" data-refresh-target="#properties-list">
    @Html.AntiForgeryToken()
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit Unit" : "Add Unit")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PropertyId" />
        <div class="mb-3">
            <label asp-for="UnitNumber" class="form-label"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Bedrooms" class="form-label"></label>
            <input asp-for="Bedrooms" class="form-control" type="number" min="0" />
            <span asp-validation-for="Bedrooms" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MonthlyRent" class="form-label"></label>
            <input asp-for="MonthlyRent" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="MonthlyRent" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="UnitTypeId" class="form-label"></label>
            <select asp-for="UnitTypeId" asp-items="Model.UnitTypeOptions" class="form-select"></select>
            <span asp-validation-for="UnitTypeId" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
