@model PropertyRentalSystem.Web.ViewModels.Shared.ConfirmDeleteViewModel
<form action="@Model.ActionUrl" method="post"
      data-refresh-url="@Model.RefreshUrl" data-refresh-target="@Model.RefreshTarget">
    @Html.AntiForgeryToken()
    <div class="modal-header">
        <h5 class="modal-title">@Model.Title</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <p>@Model.Message</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
