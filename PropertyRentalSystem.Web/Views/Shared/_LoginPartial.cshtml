@using PropertyRentalSystem.Web.Models.Domain
@if (User.Identity?.IsAuthenticated == true)
{
    <span class="navbar-text me-2">
        @User.Identity.Name (@(User.IsInRole(Roles.PropertyManager) ? "Manager" : "Applicant"))
    </span>
    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        <button type="submit" class="btn btn-link nav-link d-inline">Logout</button>
    </form>
}
else
{
    <a class="nav-link d-inline" asp-controller="Account" asp-action="Login">Login</a>
    <a class="nav-link d-inline" asp-controller="Account" asp-action="Register">Sign up</a>
}