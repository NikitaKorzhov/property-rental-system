@model List<PropertyRentalSystem.Web.ViewModels.Properties.PropertyListItemViewModel>
@{
    ViewData["Title"] = "Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a href="#" class="btn btn-primary" data-modal-url="@Url.Action("Create", "Properties")">+ Add Property</a>
</div>

<div id="properties-list">
    <partial name="_PropertiesList" model="Model" />
</div>
