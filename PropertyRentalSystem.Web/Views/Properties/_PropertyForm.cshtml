@model PropertyRentalSystem.Web.ViewModels.Properties.PropertyFormViewModel
@{
    var isEdit = Model.Id != 0;
    var action = isEdit ? Url.Action("Edit", "Properties", new { id = Model.Id }) : Url.Action("Create", "Properties");
}
<form action="@action" method="post"
      data-refresh-url="@Url.Action("List", "Properties")" data-refresh-target="#properties-list">
    @Html.AntiForgeryToken()
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit Property" : "Add Property")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
