@using PropertyRentalSystem.Web.Models.Domain
@model List<PropertyRentalSystem.Web.ViewModels.Applications.ApplicationListItemViewModel>
@{
    ViewData["Title"] = "My Applications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-action="Browse">Browse Units</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.Any())
{
    <p class="text-muted">You haven't started any applications yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Property</th><th>Unit</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.PropertyName</td>
                <td>@app.UnitNumber</td>
                <td><span class="badge bg-secondary">@app.Status</span></td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Wizard" asp-route-id="@app.Id">
                        @(app.Status is ApplicationStatus.Draft or ApplicationStatus.Returned ? "Continue" : "View")
                    </a>
                    @if (app.Status is ApplicationStatus.Draft or ApplicationStatus.Submitted or ApplicationStatus.Returned)
                    {
                        <a href="#" class="btn btn-sm btn-outline-danger"
                           data-modal-url="@Url.Action("WithdrawConfirm", new { id = app.Id })">Withdraw</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
