@using PropertyRentalSystem.Web.Models.Domain
@model PropertyRentalSystem.Web.ViewModels.Applications.ApplicationListViewModel
@{
    ViewData["Title"] = "My Applications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-action="Browse">Browse Units</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var item in Model.StatusOptions)
            {
                <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="propertyId" class="form-select">
            <option value="">All properties</option>
            @foreach (var item in Model.PropertyOptions)
            {
                <option value="@item.Value" selected="@(item.Selected ? "selected" : null)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Applications.Any())
{
    <p class="text-muted">No applications match the filter.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Property</th><th>Unit</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var app in Model.Applications)
        {
            <tr>
                <td>@app.PropertyName</td>
                <td>@app.UnitNumber</td>
                <td><partial name="_StatusBadge" model="app.Status" /></td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Wizard" asp-route-id="@app.Id">
                        @(app.Status is ApplicationStatus.Draft or ApplicationStatus.Returned ? "Continue" : "View")
                    </a>
                    @if (app.Status is ApplicationStatus.Draft or ApplicationStatus.Submitted or ApplicationStatus.Returned)
                    {
                        <a href="#" class="btn btn-sm btn-outline-danger"
                           data-modal-url="@Url.Action("WithdrawConfirm", new { id = app.Id })">Withdraw</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
