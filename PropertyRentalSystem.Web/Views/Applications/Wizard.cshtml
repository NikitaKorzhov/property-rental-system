@using PropertyRentalSystem.Web.Models.Domain
@using PropertyRentalSystem.Web.ViewModels.Applications
@model ApplicationWizardViewModel
@{
    ViewData["Title"] = "Rental Application";
}

<div class="d-flex justify-content-between align-items-center">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to My Applications</a>
</div>
<p class="text-muted">
    Unit @Model.UnitNumber — @Model.PropertyName &middot; Status: <partial name="_StatusBadge" model="Model.Status" />
</p>

@if (!string.IsNullOrWhiteSpace(Model.ReviewComment))
{
    var alertClass = Model.Status == ApplicationStatus.Denied ? "alert-danger" : "alert-warning";
    <div class="alert @alertClass">
        <strong>@(Model.Status == ApplicationStatus.Denied ? "Application denied:" : "Returned for correction:")</strong>
        @Model.ReviewComment
    </div>
}

<form asp-action="Wizard" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Step" />

    @if (Model.Step == WizardStep.ApplicantInfo)
    {
        <h4>1. Applicant Information</h4>
        <partial name="_ApplicantInfoSection" model="Model" />
    }
    else if (Model.Step == WizardStep.ResidenceHistory)
    {
        <h4>2. Residence History</h4>
        <div id="residence-history-section">
            <partial name="_ResidenceHistorySection" model="Model" />
        </div>
    }
    else
    {
        <h4>Summary</h4>
        @await Component.InvokeAsync("ApplicationSummary", new { applicationId = Model.Id })
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>

    <div class="mt-3">
        @if (Model.IsEditable && Model.Step != WizardStep.ApplicantInfo)
        {
            <button type="submit" name="action" value="Back" class="btn btn-secondary">Back</button>
        }
        @if (Model.IsEditable && Model.Step != WizardStep.Summary)
        {
            <button type="submit" name="action" value="Continue" class="btn btn-primary">Continue</button>
        }
        @if (Model.IsEditable && Model.Step == WizardStep.Summary)
        {
            <button type="submit" name="action" value="Submit" class="btn btn-success"
                    disabled="@(Model.CanSubmit ? null : "disabled")">Submit Application</button>
        }
    </div>
</form>

@if (Model.Status is ApplicationStatus.Draft or ApplicationStatus.Submitted or ApplicationStatus.Returned)
{
    <a href="#" class="btn btn-outline-danger btn-sm mt-2"
       data-modal-url="@Url.Action("WithdrawConfirm", new { id = Model.Id })">Withdraw Application</a>
}
